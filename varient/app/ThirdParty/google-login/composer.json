{
    "name": "varient/google-auth",
    "description": "Google Auth Library for Varient",
    "require": {
        "php": "^8.1",
        "google/apiclient": "^2.15"
    },
    "scripts": {
        "post-update-cmd": [
            "Google\\Task\\Composer::cleanup"
        ],
        "post-install-cmd": [
            "Google\\Task\\Composer::cleanup"
        ]
    },
    "extra": {
        "google/apiclient-services": [
            "Oauth2"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}